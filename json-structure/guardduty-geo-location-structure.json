{
  "$schema": "https://json-structure.org/meta/core/v0/#",
  "$id": "https://raw.githubusercontent.com/api-evangelist/amazon-guardduty/refs/heads/main/json-structure/guardduty-geo-location-structure.json",
  "name": "GeoLocation",
  "description": "Contains information about the location of the remote IP address.",
  "type": "object",
  "properties": {
    "Lat": {
      "allOf": [
        {
          "$ref": "#/components/schemas/Double"
        },
        {
          "xml": {
            "name": "lat"
          },
          "description": "The latitude information of the remote IP address."
        }
      ]
    },
    "Lon": {
      "allOf": [
        {
          "$ref": "#/components/schemas/Double"
        },
        {
          "xml": {
            "name": "lon"
          },
          "description": "The longitude information of the remote IP address."
        }
      ]
    }
  }
}