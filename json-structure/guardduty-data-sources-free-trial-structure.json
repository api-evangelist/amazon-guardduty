    "MalwareProtection": {
      "allOf": [
        {
          "$ref": "#/components/schemas/MalwareProtectionDataSourceFreeTrial"
        },
        {
          "xml": {
            "name": "malwareProtection"
          },
          "description": "Describes whether Malware Protection is enabled as a data source."
        }
