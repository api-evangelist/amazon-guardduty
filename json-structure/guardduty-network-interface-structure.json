        }
      ]
    },
    "PublicIp": {
      "allOf": [
        {
          "$ref": "#/components/schemas/String"
        },
        {
          "xml": {
            "name": "publicIp"
          },
          "description": "The public IP address of the EC2 instance."
        }
      ]
