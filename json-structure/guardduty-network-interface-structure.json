    "SecurityGroups": {
      "allOf": [
        {
          "$ref": "#/components/schemas/SecurityGroups"
        },
        {
          "xml": {
            "name": "securityGroups"
          },
          "description": "The security groups associated with the EC2 instance."
        }
      ]
