        {
          "$ref": "#/components/schemas/String"
        },
        {
          "xml": {
            "name": "adminAccountId"
          },
          "description": "The Amazon Web Services account ID for the account."
        }
      ]
    },
    "AdminStatus": {
      "allOf": [
        {
          "$ref": "#/components/schemas/AdminStatus"
        },
        {
          "xml": {
            "name": "adminStatus"
          },
