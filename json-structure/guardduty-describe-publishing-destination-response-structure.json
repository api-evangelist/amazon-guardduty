      "allOf": [
        {
          "$ref": "#/components/schemas/Long"
        },
        {
          "xml": {
            "name": "publishingFailureStartTimestamp"
          },
          "description": "The time, in epoch millisecond format, at which GuardDuty was first unable to publish findings to the destination."
