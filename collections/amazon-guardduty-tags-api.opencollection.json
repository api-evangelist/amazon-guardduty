{
  "opencollection": "1.0.0",
  "info": {
    "name": "Amazon GuardDuty Admin Tags API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Tags",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Amazon GuardDuty List Tags for Resource",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://guardduty.{region}.amazonaws.com/tags/:resourceArn",
            "headers": [
              {
                "name": "X-Amz-Content-Sha256",
                "value": ""
              },
              {
                "name": "X-Amz-Date",
                "value": ""
              },
              {
                "name": "X-Amz-Algorithm",
                "value": ""
              },
              {
                "name": "X-Amz-Credential",
                "value": ""
              },
              {
                "name": "X-Amz-Security-Token",
                "value": ""
              },
              {
                "name": "X-Amz-Signature",
                "value": ""
              },
              {
                "name": "X-Amz-SignedHeaders",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "resourceArn",
                "value": "",
                "type": "path",
                "description": "The Amazon Resource Name (ARN) for the given GuardDuty resource. "
              }
            ]
          },
          "docs": "Lists tags for a resource. Tagging is currently supported for detectors, finding filters, IP sets, and threat intel sets, with a limit of 50 tags per resource. When invoked, this operation returns all assigned tags for a given resource."
        },
        {
          "info": {
            "name": "Amazon GuardDuty Tag Resource",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://guardduty.{region}.amazonaws.com/tags/:resourceArn",
            "headers": [
              {
                "name": "X-Amz-Content-Sha256",
                "value": ""
              },
              {
                "name": "X-Amz-Date",
                "value": ""
              },
              {
                "name": "X-Amz-Algorithm",
                "value": ""
              },
              {
                "name": "X-Amz-Credential",
                "value": ""
              },
              {
                "name": "X-Amz-Security-Token",
                "value": ""
              },
              {
                "name": "X-Amz-Signature",
                "value": ""
              },
              {
                "name": "X-Amz-SignedHeaders",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "resourceArn",
                "value": "",
                "type": "path",
                "description": "The Amazon Resource Name (ARN) for the GuardDuty resource to apply a tag to."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Adds tags to a resource."
        },
        {
          "info": {
            "name": "Amazon GuardDuty Untag Resource",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "http://guardduty.{region}.amazonaws.com/tags/:resourceArn#tagKeys",
            "headers": [
              {
                "name": "X-Amz-Content-Sha256",
                "value": ""
              },
              {
                "name": "X-Amz-Date",
                "value": ""
              },
              {
                "name": "X-Amz-Algorithm",
                "value": ""
              },
              {
                "name": "X-Amz-Credential",
                "value": ""
              },
              {
                "name": "X-Amz-Security-Token",
                "value": ""
              },
              {
                "name": "X-Amz-Signature",
                "value": ""
              },
              {
                "name": "X-Amz-SignedHeaders",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "resourceArn",
                "value": "",
                "type": "path",
                "description": "The Amazon Resource Name (ARN) for the resource to remove tags from."
              },
              {
                "name": "tagKeys",
                "value": "",
                "type": "query",
                "description": "The tag keys to remove from the resource."
              }
            ]
          },
          "docs": "Removes tags from a resource."
        }
      ]
    }
  ],
  "bundled": true
}